<mxfile host="app.diagrams.net">
  <diagram name="Recruitment &amp; Onboarding SOP" id="qflow-procedure">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1"
        arrows="1" fold="1" page="1" pageScale="1" pageWidth="660" pageHeight="2120"
        math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Recruitment &amp; Onboarding SOP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="660" height="50" as="geometry" /></mxCell>
        <mxCell id="lanehdr0" value="Manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4472C4;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="lanecol0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BFBFBF;dashed=1;" vertex="1" parent="1"><mxGeometry x="0" y="100" width="220" height="2020" as="geometry" /></mxCell>
        <mxCell id="lanehdr1" value="HR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ED7D31;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="50" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="lanecol1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BFBFBF;dashed=1;" vertex="1" parent="1"><mxGeometry x="220" y="100" width="220" height="2020" as="geometry" /></mxCell>
        <mxCell id="lanehdr2" value="Process Owner" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7030A0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="50" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="lanecol2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BFBFBF;dashed=1;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="220" height="2020" as="geometry" /></mxCell>
        <mxCell id="phase0" value="Phase 1 - Requisition &amp; Posting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#BFBFBF;fontStyle=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="100" width="660" height="40" as="geometry" /></mxCell>
        <mxCell id="n0" value="1. Raise a formal hiring request with required competencies&amp;#10;(1 day)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEFB;strokeColor=#4472C4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20.0" y="163.0" width="180" height="74" as="geometry" /></mxCell>
        <mxCell id="n1" value="2. Verify budget and org structure for the position&amp;#10;(1 day)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240.0" y="283.0" width="180" height="74" as="geometry" /></mxCell>
        <mxCell id="n2" value="3. Post the vacancy through approved internal/external channels&amp;#10;(2 days)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240.0" y="403.0" width="180" height="74" as="geometry" /></mxCell>
        <mxCell id="phase1" value="Phase 2 - Screening &amp; HR Interview" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BFBFBF;fontStyle=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="660" height="40" as="geometry" /></mxCell>
        <mxCell id="n3" value="4. Receive and log applications&amp;#10;(Ongoing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240.0" y="563.0" width="180" height="74" as="geometry" /></mxCell>
        <mxCell id="n4" value="5. Screen CVs against position requirements&amp;#10;(3 days)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240.0" y="683.0" width="180" height="74" as="geometry" /></mxCell>
        <mxCell id="n5" value="6. Conduct HR interview (traits, culture fit)&amp;#10;(45 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240.0" y="803.0" width="180" height="74" as="geometry" /></mxCell>
        <mxCell id="n6" value="7. Gate: did the candidate pass the HR interview?&amp;#10;(10 min)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="245.0" y="915.0" width="170" height="90" as="geometry" /></mxCell>
        <mxCell id="phase2" value="Phase 3 - Technical Interview &amp; Decision" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#BFBFBF;fontStyle=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="1020" width="660" height="40" as="geometry" /></mxCell>
        <mxCell id="n7" value="8. Conduct technical interview&amp;#10;(1 hr)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEFB;strokeColor=#4472C4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20.0" y="1083.0" width="180" height="74" as="geometry" /></mxCell>
        <mxCell id="n8" value="9. Gate: did the candidate pass the technical interview?&amp;#10;(10 min)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25.0" y="1195.0" width="170" height="90" as="geometry" /></mxCell>
        <mxCell id="n9" value="10. Prepare evaluation report and recommendation&amp;#10;(1 day)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240.0" y="1323.0" width="180" height="74" as="geometry" /></mxCell>
        <mxCell id="n10" value="11. Submit report to Executive Office for final approval&amp;#10;(2 days)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="465.0" y="1435.0" width="170" height="90" as="geometry" /></mxCell>
        <mxCell id="phase3" value="Phase 4 - Contracting &amp; Documentation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2D5F1;strokeColor=#BFBFBF;fontStyle=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="1540" width="660" height="40" as="geometry" /></mxCell>
        <mxCell id="n11" value="12. Notify candidate and issue written offer&amp;#10;(1 day)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240.0" y="1603.0" width="180" height="74" as="geometry" /></mxCell>
        <mxCell id="n12" value="13. Collect documents, sign contract, register in HRIS&amp;#10;(3 days)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240.0" y="1723.0" width="180" height="74" as="geometry" /></mxCell>
        <mxCell id="n13" value="14. Employee starts; file activated in the system&amp;#10;(1 day)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#38761D;fontSize=10;" vertex="1" parent="1"><mxGeometry x="250.0" y="1850.0" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="phase4" value="Rejected Candidates (from either gate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D0E0E3;strokeColor=#BFBFBF;fontStyle=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="1940" width="660" height="40" as="geometry" /></mxCell>
        <mxCell id="n14" value="15. Reject candidate and notify formally&amp;#10;(1 day)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#38761D;fontSize=10;" vertex="1" parent="1"><mxGeometry x="250.0" y="2010.0" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=9;fontColor=#595959;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#595959;fontSize=9;fontColor=#595959;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
